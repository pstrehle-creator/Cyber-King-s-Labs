# Copy to .env and fill in. .env holds secrets: don't commit it.

# Dashboard
# Long random string so logins survive restarts, e.g. from:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
# Set to 1 once the dashboard is served over HTTPS (via a reverse proxy).
DASHBOARD_SECURE_COOKIES=0

# Scheduler
CHECK_INTERVAL_SECONDS=21600
CHECK_ARGS=--email --slack --escalate-after 24
# Space-separated domains to watch in Certificate Transparency logs (daily).
DISCOVER_DOMAINS=
DISCOVER_ARGS=--email --slack
KEEP_DAYS=90

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
ESCALATION_EMAILS=

# Slack alerts
SLACK_WEBHOOK_URL=
ESCALATION_SLACK_WEBHOOK_URL=
